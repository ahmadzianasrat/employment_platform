# Serves index.html for any route that isn't a real file/folder on disk,
# so React Router's client-side routes (e.g. /jobs/abc123, /admin, /saved)
# work correctly on direct load, refresh, or a shared link — not just when
# navigated to from within the app.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let real files/folders (JS, CSS, images, etc.) serve normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else falls through to index.html, where React Router takes over.
  RewriteRule ^ index.html [L]
</IfModule>
